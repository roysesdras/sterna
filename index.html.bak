			max-width: 15%;
			--container-widget-width: 15%;
			--container-widget-flex-grow: 0;
		}

		.elementor-574 .elementor-element.elementor-element-ae90c4b.elementor-element {
			--align-self: center;
		}

		.elementor-574 .elementor-element.elementor-element-ae90c4b img {
			width: 100%;
			max-width: 100%;
			height: 180px;
			object-fit: cover;
			object-position: center center;
