	<style>
		/* --- Sterna Colors Custom Navbar Styles --- */
		/* 1. Navbar background color (change emerald green to white) */
		.elementor-574 .elementor-element.elementor-element-8184513:not(.elementor-motion-effects-element-type-background),
		.elementor-574 .elementor-element.elementor-element-8184513>.elementor-motion-effects-container>.elementor-motion-effects-layer {
			background-color: #ffffff !important;
		}

		/* 2. Style main menu items as rounded blue buttons (sleeker medium size) */
		.elementor-widget-nav-menu .elementor-nav-menu--main .elementor-item {
			color: #ffffff !important;
			background-color: #085191 !important;
			padding: 6px 12px !important;
			border-radius: 18px !important;
			margin: 2px 3px !important;
			font-size: 14px !important;
			line-height: 1.2 !important;
			height: auto !important;
			transition: all 0.25s ease-in-out !important;
			display: inline-flex !important;
			align-items: center !important;
			font-weight: 600 !important;
			border: none !important;
		}

		/* Make sub-menu indicator icons white */
		.elementor-widget-nav-menu .elementor-nav-menu--main .elementor-item svg {
			fill: #ffffff !important;
			margin-left: 5px !important;
			width: 9px !important;
			height: 9px !important;
		}

		/* 3. Main menu items hover state (background becomes yellow, text becomes blue) */
		.elementor-widget-nav-menu .elementor-nav-menu--main .elementor-item:hover,
		.elementor-widget-nav-menu .elementor-nav-menu--main .elementor-item.elementor-item-active,
		.elementor-widget-nav-menu .elementor-nav-menu--main .elementor-item.highlighted,
		.elementor-widget-nav-menu .elementor-nav-menu--main .elementor-item:focus {
			color: #085191 !important;
			background-color: #fcb900 !important;
			fill: #085191 !important;
		}

		.elementor-widget-nav-menu .elementor-nav-menu--main .elementor-item:hover svg {
			fill: #085191 !important;
		}

		/* Ensure mobile menu links do not have rounded blue buttons structure to avoid visual mess on dropdown stack */
		@media (min-width: 768px) {

			/* desktop menu container flex wrap */
			.elementor-nav-menu--main {
				display: flex !important;
				flex-wrap: wrap !important;
				align-items: center !important;
			}
		}

		/* Ensure the hamburger toggle button is Sterna blue on white background */
		.elementor-574 .elementor-element.elementor-element-578d3e7 .elementor-nav-menu--dropdown a,
		.elementor-574 .elementor-element.elementor-element-578d3e7 .elementor-menu-toggle {
			color: #085191 !important;
			fill: #085191 !important;
		}

		.elementor-574 .elementor-element.elementor-element-578d3e7 .elementor-menu-toggle svg {
			fill: #085191 !important;
		}

		.elementor-574 .elementor-element.elementor-element-578d3e7 div.elementor-menu-toggle {
			color: #085191 !important;
		}

		.elementor-574 .elementor-element.elementor-element-578d3e7 div.elementor-menu-toggle svg {
			fill: #085191 !important;
		}

		/* "Me connecter" login button custom styling (blue background, white text) */
		.elementor-element.elementor-element-3be5492 .elementor-button {
			background-color: #085191 !important;
			color: #ffffff !important;
			border-radius: 18px !important;
			padding: 6px 14px !important;
			font-size: 14px !important;
			font-weight: 600 !important;
			transition: all 0.25s ease-in-out !important;
			display: inline-flex !important;
			align-items: center !important;
			border: none !important;
		}

		.elementor-element.elementor-element-3be5492 .elementor-button:hover {
			background-color: #fcb900 !important;
			color: #085191 !important;
		}

		.elementor-element.elementor-element-3be5492 .elementor-button svg {
			fill: #ffffff !important;
			margin-right: 5px !important;
		}

		.elementor-element.elementor-element-3be5492 .elementor-button:hover svg {
			fill: #085191 !important;
		}

		/* Custom search form icon and border colors */
		.elementor-search-form__container {
			border: 1px solid #085191 !important;
		}

		.elementor-search-form__icon svg {
			fill: #085191 !important;
		}

		.elementor-search-form__submit svg {
			fill: #085191 !important;
		}

		.elementor-search-form__input {
			color: #085191 !important;
		}

		.elementor-search-form__input::placeholder {
			color: #085191 !important;
			opacity: 0.75 !important;
		}

		/* 4. Desktop logo cropping fix - apply to all screen sizes (enlarged more 2) */
		.elementor-574 .elementor-element.elementor-element-ae90c4b img {
			height: auto !important;
			max-height: 130px !important;
			/* Limit height on desktop to fit header */
			object-fit: contain !important;
			width: auto !important;
			max-width: 100% !important;
		}

		/* --- Mobile Navbar Adjustments --- */
		@media (max-width: 767px) {

			/* Ensure parent container displays items on single row, relative anchor, and centered search */
			.elementor-574 .elementor-element.elementor-element-8184513>.e-con-inner,
			.elementor-574 .elementor-element.elementor-element-8184513 .e-con-inner {
				display: flex !important;
				flex-wrap: nowrap !important;
				flex-direction: row !important;
				position: relative !important;
				height: 62px !important;
				/* Fit the larger logo safely */
				align-items: center !important;
				justify-content: center !important;
				/* Centers the search bar */
				padding: 0 12px !important;
			}

			/* 1. Logo container styling on mobile (Absolute Left) */
			.elementor-574 .elementor-element.elementor-element-ae90c4b {
				position: absolute !important;
				left: 12px !important;
				top: 50% !important;
				transform: translateY(-50%) !important;
				width: auto !important;
				max-width: 32% !important;
				/* Increased width limit to accommodate larger logo */
				margin: 0 !important;
				padding: 0 !important;
				z-index: 10 !important;
				display: flex !important;
				align-items: center !important;
			}

			/* Logo image sizing (enlarged further for excellent visibility) on mobile */
			.elementor-574 .elementor-element.elementor-element-ae90c4b img {
				width: auto !important;
				max-width: 100% !important;
				height: auto !important;
				max-height: 52px !important;
				/* Enlarged from 44px to 52px */
				object-fit: contain !important;
			}

			/* 2. Search section on mobile (Perfect Centered Middle, Thinner) */
			.elementor-element-d01517a {
				display: flex !important;
				width: 50% !important;
				/* Adjusted slightly to avoid overlap with larger logo */
				max-width: 60% !important;
				margin: 0 auto !important;
				z-index: 5 !important;
				justify-content: center !important;
				align-items: center !important;
			}

			.elementor-element-d01517a .elementor-widget-container,
			.elementor-element-d01517a .elementor-search-form {
				width: 100% !important;
				display: flex !important;
				justify-content: center !important;
				align-items: center !important;
			}

			/* Search container sleek capsule shape, 20px height (extra thin), solid blue border */
			.elementor-574 .elementor-element.elementor-element-d01517a:not(.elementor-search-form--skin-full_screen) .elementor-search-form__container {
				width: 100% !important;
				display: flex !important;
				height: 20px !important;
				/* Thinner height (reduced from 24px) */
				border: 1px solid #085191 !important;
				border-radius: 99px !important;
				/* Perfect capsule borders */
				overflow: hidden !important;
				background-color: #ffffff !important;
				align-items: center !important;
			}

			/* Search input compact text, padding, and height */
			.elementor-search-form__input {
				font-size: 9.5px !important;
				/* Sized down to fit the 20px height */
				padding-left: 10px !important;
				padding-right: 3px !important;
				height: 100% !important;
				border: none !important;
				background: transparent !important;
				color: #085191 !important;
				line-height: 20px !important;
			}

			/* Reduce search button/icon size and align it */
			.elementor-search-form__submit {
				width: 20px !important;
				height: 20px !important;
				padding: 0 !important;
				display: flex !important;
				align-items: center !important;
				justify-content: center !important;
				background: transparent !important;
				border: none !important;
			}

			.elementor-search-form__submit svg {
				width: 8px !important;
				height: 8px !important;
				fill: #085191 !important;
			}

			/* 3. Hamburger menu toggle container on mobile (Absolute Right) */
			.elementor-574 .elementor-element.elementor-element-578d3e7 {
				position: absolute !important;
				right: 12px !important;
				top: 50% !important;
				transform: translateY(-50%) !important;
				width: auto !important;
				margin: 0 !important;
				padding: 0 !important;
				z-index: 10 !important;
				display: flex !important;
				align-items: center !important;
			}

			/* Enlarge hamburger menu icon size */
			.elementor-574 .elementor-element.elementor-element-578d3e7 .elementor-menu-toggle {
				font-size: 26px !important;
				/* Increased font-size for default icon */
				display: flex !important;
				align-items: center !important;
				justify-content: center !important;
			}

			.elementor-574 .elementor-element.elementor-element-578d3e7 .elementor-menu-toggle svg {
				width: 26px !important;
				/* Increased size for svg icon */
				height: 26px !important;
			}

			/* Hamburger mobile dropdown background color (change from green to Sterna blue #085191) */
			.elementor-574 .elementor-element.elementor-element-578d3e7 .elementor-nav-menu--dropdown {
				background-color: #085191 !important;
				width: 100vw !important;
				/* Full screen width for the expanded dropdown menu */
				position: absolute !important;
				left: auto !important;
				right: -12px !important;
				/* Align to the right edge of page padding */
				top: 100% !important;
				z-index: 9999 !important;
			}

			/* On mobile dropdown, make items white on blue background and reduce vertical spacing (padding) */
			.elementor-574 .elementor-element.elementor-element-578d3e7 .elementor-nav-menu--dropdown .elementor-item,
			.elementor-574 .elementor-element.elementor-element-578d3e7 .elementor-nav-menu--dropdown .elementor-sub-item {
				background-color: transparent !important;
				color: #ffffff !important;
				border-radius: 0 !important;
				margin: 0 !important;
				padding-top: 6px !important;
				padding-bottom: 2px !important;
				padding-left: 15px !important;
				padding-right: 15px !important;
				font-size: 19px !important;
			}

			/* Mobile dropdown sub-menu arrow indicators */
			.elementor-574 .elementor-element.elementor-element-578d3e7 .elementor-nav-menu--dropdown .elementor-item svg {
				fill: #ffffff !important;
			}

			/* Mobile dropdown links hover state (background becomes yellow, text/svg becomes blue) */
			.elementor-574 .elementor-element.elementor-element-578d3e7 .elementor-nav-menu--dropdown a:hover,
			.elementor-574 .elementor-element.elementor-element-578d3e7 .elementor-nav-menu--dropdown a:focus,
			.elementor-574 .elementor-element.elementor-element-578d3e7 .elementor-nav-menu--dropdown a.elementor-item-active,
			.elementor-574 .elementor-element.elementor-element-578d3e7 .elementor-nav-menu--dropdown a.highlighted {
				background-color: #fcb900 !important;
				color: #085191 !important;
