		/* Start custom CSS for shortcode, class: .elementor-element-80bf525 */
		.elementor-603 .elementor-element.elementor-element-80bf525 .gform_required_legend {
			display: none;
		}

		.elementor-603 .elementor-element.elementor-element-80bf525 .gfield_required {
