		}

		.elementor-603 .elementor-element.elementor-element-80bf525 label {
			color: black;
			padding-left: 24px;
			font-size: 17px;
		}

		.elementor-603 .elementor-element.elementor-element-80bf525 .gfield_description {
			color: white;
			padding-left: 24px;
		}

		.elementor-603 .elementor-element.elementor-element-80bf525 input,
		.elementor-603 .elementor-element.elementor-element-80bf525 select {
			padding: 0px 20px !important;
			color: black !important;
			border: none;
			border-radius: 40px;
			font-size: 14px;
		}

		.elementor-603 .elementor-element.elementor-element-80bf525 .gform_fields {
			row-gap: 15px;
		}

		.elementor-603 .elementor-element.elementor-element-80bf525 #gform_submit_button_2 {
			background-color: #49B0E7;
			border: none;
			border-radius: 30px;
			padding: 10px 35px !important;
			color: white !important;
			font-size: 30px;
			font-weight: 700;
		}

		.elementor-603 .elementor-element.elementor-element-80bf525 #gform_submit_button_2:hover {
			background-color: white;
			color: black !important;
		}

		.elementor-603 .elementor-element.elementor-element-80bf525 .gform_footer {
			justify-content: center;
			margin-top: 50px;
		}

